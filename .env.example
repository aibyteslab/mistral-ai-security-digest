# Mistral API (https://console.mistral.ai)
MISTRAL_API_KEY=""

# GitHub token (optional — increases rate limit from 60 to 5000 req/hr)
# Generate at https://github.com/settings/tokens (no scopes needed)
GITHUB_TOKEN=""

# SMTP (Gmail example — use App Password, not account password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# Recipient email address
ALERT_TO="recipient@yourdomain.com"
